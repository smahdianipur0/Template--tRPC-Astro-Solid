---
import Card from "../components/Card.astro"

---
<Card title = "db interaction" cardID='db-card'>
    
    <button id="create-permission"> registration </button>
    <button id="authentication"> authentication </button>
    <h2 id="db-result"></h2>

</Card>

<script>

import { trpc } from "../utils/trpc";
import queryHelper from "../utils/query-helper"
import {client} from '@passwordless-id/webauthn'



document.getElementById("db-card")!.addEventListener("click", (e) => {
    if ((e!.target as HTMLInputElement).matches("#create-permission")) {
        (async () => {
            const [data, error] = await queryHelper.mutate("db", () => trpc.challenge.query());
            if (data?.message) {
                const registration = await client.register({
                  user: "Arnaud",
                  challenge: data.message,
                });

                console.log(registration);
                const [registryData, registryError] = await queryHelper.mutate("db", async () => {
                    return await trpc.registry.mutate({
                        challenge: data.message,
                        registry: registration,
                    });
                });
                console.log(registryData, registryError);

            }
        })();
    }

    if ((e!.target as HTMLInputElement).matches("#authentication")) {
        (async () => {
            const [data, error] = await queryHelper.mutate("db", () => trpc.challenge.query());
            if (data?.message) {
                const authentication = await client.authenticate({
                  challenge: data.message,
                  timeout: 60000
                });

                console.log(authentication);
                const [authData, authError] = await queryHelper.mutate("auth", async () => {
                    return await trpc.authenticate.mutate({
                        challenge: data.message,
                        authenticationData: authentication,
                    });
                });
                console.log(authData, authError)

            }
        })();
    }
    
});


</script>