<div id="say-hello" class="skeleton-parrent">
  <div style="width:15ch ;" class="skeleton"> </div>
</div>

<script>
import { trpc } from "../utils/trpc";
import queryHelper, {cache} from "../utils/query-helper";
type helloRes = { message: string; [key: string]: unknown };

async function helloHandler() {
  const cached: helloRes = cache.get("hello");
  if (cached?.message){
    document.getElementById("say-hello")!.textContent = cached?.message;
  }

  const [data, error] = await queryHelper.fetch("hello", () => trpc.greeting.query());
  if ( queryHelper.invalidateCache(cached, data, error)) {
    document.getElementById("say-hello")!.textContent = data?.message ?? error?.message ?? "";
  }
}


await helloHandler();
queryHelper.revalidatListener(async() => await helloHandler()); 

</script>